# Copy to .env for local development. Never commit .env.

ENV=local

# Postgres. Locally this is the apt-installed Postgres 16 with pgvector.
# On Railway, set this to the Supabase connection string (session pooler, port 5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai_test

# Supabase Auth. Either the legacy HS256 JWT secret, or leave it empty and the
# API fetches JWKS from SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Content
CONTENT_DIR=../../content

# Embeddings: fake | deepinfra
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# LLM: fake | openrouter | anthropic. OpenRouter is production (D32).
# LLM_MODEL defaults to anthropic/claude-opus-5 on openrouter and claude-opus-5 on anthropic.
LLM_PROVIDER=fake
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Audio: local | supabase. TTS_ENGINE: fake | mms | xtts | google.
AUDIO_STORE=local
AUDIO_LOCAL_DIR=data/audio
AUDIO_BASE_URL=http://localhost:8000/audio
AUDIO_BUCKET=audio
SUPABASE_SERVICE_ROLE_KEY=
TTS_ENGINE=fake
XTTS_SPEAKER_WAV=
