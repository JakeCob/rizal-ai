# Copy to .env for local development. Never commit .env.

ENV=local

# Postgres with pgvector. Locally the apt-installed Postgres 16; on Railway the
# project's Postgres service over its private domain, asyncpg scheme (docs/deploy.md).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai_test

# Sessions (D33). The API signs anonymous session tokens with this secret.
# Generate with: openssl rand -hex 32. AUTH_JWKS_URL is for a future identity provider.
SESSION_JWT_SECRET=
AUTH_JWKS_URL=

# CORS (D36). Web origins allowed to call the API, comma-separated; empty means none.
# CORS_ORIGIN_REGEX optionally admits Vercel preview hostnames.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=

# Content
CONTENT_DIR=../../content

# Embeddings: fake | deepinfra
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# LLM: fake | openrouter | anthropic. OpenRouter is production (D32).
# LLM_MODEL defaults to anthropic/claude-opus-5 on openrouter and claude-opus-5 on anthropic.
LLM_PROVIDER=fake
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Audio: local | s3 (Railway bucket). URLs always point at the API's /audio/{key}.
# TTS_ENGINE: fake | mms | xtts | google.
AUDIO_STORE=local
AUDIO_LOCAL_DIR=data/audio
AUDIO_BASE_URL=http://localhost:8000/audio
S3_ENDPOINT_URL=
S3_BUCKET=audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
TTS_ENGINE=fake
XTTS_SPEAKER_WAV=
