# Copy to .env for local development. Never commit .env.

ENV=local

# Postgres. Locally this is the apt-installed Postgres 16 with pgvector.
# On Railway, set this to the Supabase connection string (session pooler, port 5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai_test

# Supabase Auth. Either the legacy HS256 JWT secret, or leave it empty and the
# API fetches JWKS from SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Content
CONTENT_DIR=../../content

# Embeddings: fake | deepinfra
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# LLM (plan 002)
ANTHROPIC_API_KEY=
