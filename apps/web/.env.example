# Copy to .env.local. Never commit .env.local.

# mock: serve fixtures, no backend or credentials needed (unit tests, Playwright, quick UI work)
# leave empty to talk to the real API
NEXT_PUBLIC_API_MODE=mock

NEXT_PUBLIC_API_URL=http://localhost:8000
# The API's CORS_ORIGINS must include this app's origin (http://localhost:3000 by default).
# Identity comes from POST /session/anonymous on the API (D33); nothing else is needed.
