      "required": [
        "layers",
        "lesson_id",
        "model",
        "prompt_version",
        "reflection",
        "status"
      ],
      "title": "ReflectionOut",
      "type": "object"
    },
    "ResultOut": {
      "properties": {
        "correct": {
          "title": "Correct",
