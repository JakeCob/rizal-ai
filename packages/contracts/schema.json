    "SentenceAssembly": {
      "additionalProperties": false,
      "description": "Build the Tagalog line from a word bank, given the English.",
      "properties": {
        "answer_tokens": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Answer Tokens",
          "type": "array"
        },
        "bank": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bank",
          "type": "array"
        },
        "key": {
          "description": "Stable key within the lesson",
          "maxLength": 20,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "prompt_en": {
          "minLength": 1,
          "title": "Prompt En",
          "type": "string"
