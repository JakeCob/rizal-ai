      "title": "ResultOut",
      "type": "object"
    },
    "ReviewAnswerIn": {
      "properties": {
        "duration_ms": {
          "default": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "exercise_id": {
          "format": "uuid",
          "title": "Exercise Id",
          "type": "string"
        },
        "response": {
