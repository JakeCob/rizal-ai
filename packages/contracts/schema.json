{
  "$defs": {
    "AttemptIn": {
      "properties": {
        "correct": {
          "description": "The client's local grade; recorded but not trusted",
          "title": "Correct",
          "type": "boolean"
        },
        "duration_ms": {
          "maximum": 3600000,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "exercise_id": {
          "format": "uuid",
          "title": "Exercise Id",
          "type": "string"
        },
        "response": {
          "additionalProperties": true,
          "title": "Response",
          "type": "object"
        }
      },
      "required": [
        "correct",
        "duration_ms",
        "exercise_id",
        "response"
      ],
      "title": "AttemptIn",
      "type": "object"
    },
    "AttemptOut": {
      "properties": {
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "hearts": {
          "title": "Hearts",
          "type": "integer"
        }
      },
      "required": [
        "correct",
        "hearts"
      ],
      "title": "AttemptOut",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "properties": {
        "audio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Url"
        },
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "exercise_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exercise key to run after this beat",
          "title": "Exercise After"
        },
        "line_id": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "tl": {
          "minLength": 1,
          "title": "Tl",
          "type": "string"
        }
      },
      "required": [
        "audio_url",
        "en",
        "exercise_after",
        "line_id",
        "speaker",
        "tl"
      ],
      "title": "Beat",
      "type": "object"
    },
    "CompleteOut": {
      "properties": {
        "hearts": {
          "title": "Hearts",
          "type": "integer"
        },
        "lesson_id": {
          "format": "uuid",
          "title": "Lesson Id",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ResultOut"
          },
          "title": "Results",
          "type": "array"
        },
        "streak_count": {
          "title": "Streak Count",
          "type": "integer"
        },
        "total_xp": {
          "title": "Total Xp",
          "type": "integer"
        },
        "xp_earned": {
          "title": "Xp Earned",
          "type": "integer"
        }
      },
      "required": [
        "hearts",
        "lesson_id",
        "results",
        "streak_count",
        "total_xp",
        "xp_earned"
      ],
      "title": "CompleteOut",
      "type": "object"
    },
    "ComprehensionMC": {
      "additionalProperties": false,
      "description": "Multiple choice about the passage.",
      "properties": {
        "correct_index": {
          "minimum": 0,
          "title": "Correct Index",
          "type": "integer"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "key": {
          "description": "Stable key within the lesson",
          "maxLength": 20,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "type": {
          "const": "comprehension_mc",
          "title": "Type",
          "type": "string"
        },
        "xp": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Xp",
          "type": "integer"
        }
      },
      "required": [
        "correct_index",
        "explanation",
        "key",
        "options",
        "question",
        "type",
        "xp"
      ],
      "title": "ComprehensionMC",
      "type": "object"
    },
    "ExerciseOut": {
      "properties": {
        "exercise": {
          "discriminator": {
            "mapping": {
              "comprehension_mc": "#/$defs/ComprehensionMC",
              "listen_tap": "#/$defs/ListenTap",
              "sentence_assembly": "#/$defs/SentenceAssembly",
              "translate_line": "#/$defs/TranslateLine"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SentenceAssembly"
            },
            {
              "$ref": "#/$defs/TranslateLine"
            },
            {
              "$ref": "#/$defs/ListenTap"
            },
            {
              "$ref": "#/$defs/ComprehensionMC"
            }
          ],
          "title": "Exercise"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "order_index": {
          "title": "Order Index",
          "type": "integer"
        }
      },
      "required": [
        "exercise",
        "id",
        "order_index"
      ],
      "title": "ExerciseOut",
      "type": "object"
    },
    "LayerOut": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "language": {
          "enum": [
            "es",
            "tl",
            "en"
          ],
          "title": "Language",
          "type": "string"
        },
        "passages": {
          "items": {
            "$ref": "#/$defs/PassageOut"
          },
          "title": "Passages",
          "type": "array"
        },
        "translator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Translator"
        }
      },
      "required": [
        "label",
        "language",
        "passages",
        "translator"
      ],
      "title": "LayerOut",
      "type": "object"
    },
    "LessonOut": {
      "properties": {
        "estimated_minutes": {
          "title": "Estimated Minutes",
          "type": "integer"
        },
        "exercises": {
          "items": {
            "$ref": "#/$defs/ExerciseOut"
          },
          "title": "Exercises",
          "type": "array"
        },
        "grammar_focus": {
          "items": {
            "type": "string"
          },
          "title": "Grammar Focus",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "source_passage_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Passage Ids",
          "type": "array"
        },
        "target_vocab": {
          "items": {
            "$ref": "#/$defs/VocabItem"
          },
          "title": "Target Vocab",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "unit_id": {
          "format": "uuid",
          "title": "Unit Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "vignette": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "title": "Vignette",
          "type": "array"
        }
      },
      "required": [
        "estimated_minutes",
        "exercises",
        "grammar_focus",
        "id",
        "slug",
        "source_passage_ids",
        "target_vocab",
        "title",
        "unit_id",
        "version",
        "vignette"
      ],
      "title": "LessonOut",
      "type": "object"
    },
    "ListenTap": {
      "additionalProperties": false,
      "description": "Hear a Tagalog line, tap the words heard.",
      "properties": {
        "answer_tokens": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Answer Tokens",
          "type": "array"
        },
        "audio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Url"
        },
        "bank": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bank",
          "type": "array"
        },
        "key": {
          "description": "Stable key within the lesson",
          "maxLength": 20,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "transcript_tl": {
          "minLength": 1,
          "title": "Transcript Tl",
          "type": "string"
        },
        "type": {
          "const": "listen_tap",
          "title": "Type",
          "type": "string"
        },
        "xp": {
          "default": 10,
          "maximum": 100,
          "minimum": 0,
          "title": "Xp",
          "type": "integer"
        }
      },
      "required": [
        "answer_tokens",
        "audio_url",
        "bank",
        "key",
        "transcript_tl",
        "type",
        "xp"
      ],
      "title": "ListenTap",
      "type": "object"
    },
    "PassageOut": {
      "properties": {
        "chapter": {
          "title": "Chapter",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "paragraph_index": {
          "title": "Paragraph Index",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chapter",
        "id",
        "paragraph_index",
        "text"
      ],
      "title": "PassageOut",
      "type": "object"
    },
    "QuotedSpan": {
      "description": "A span of the reflection that carries Rizal's byline. Must be a\nverbatim substring of the cited passage (DECISIONS.md D03).",
      "properties": {
        "passage_id": {
          "format": "uuid",
          "title": "Passage Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "text"
      ],
      "title": "QuotedSpan",
      "type": "object"
    },
    "ReflectionDraft": {
      "description": "What the model returns. Tagalog is written first (D02).",
      "properties": {
        "en": {
          "description": "English rendering of the Tagalog reflection",
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "quoted_spans": {
          "items": {
            "$ref": "#/$defs/QuotedSpan"
          },
          "title": "Quoted Spans",
          "type": "array"
        },
        "tl": {
          "description": "Reflection in modern Tagalog, in Rizal's voice",
          "minLength": 1,
          "title": "Tl",
          "type": "string"
        }
      },
      "required": [
        "en",
        "quoted_spans",
        "tl"
      ],
      "title": "ReflectionDraft",
      "type": "object"
    },
    "ReflectionOut": {
      "properties": {
        "layers": {
          "items": {
            "$ref": "#/$defs/LayerOut"
          },
          "title": "Layers",
          "type": "array"
        },
        "lesson_id": {
          "format": "uuid",
          "title": "Lesson Id",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "reflection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReflectionDraft"
