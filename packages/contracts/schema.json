        "answer_tokens": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Answer Tokens",
          "type": "array"
        },
        "bank": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Bank",
          "type": "array"
        },
        "direction": {
          "enum": [
            "tl_to_en",
            "en_to_tl"
