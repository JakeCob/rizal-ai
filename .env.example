# RizalAI environment reference. One place to see every variable both apps read.
#
# This file is documentation. The apps read their own files:
#   apps/api/.env          (copy from apps/api/.env.example)
#   apps/web/.env.local    (copy from apps/web/.env.example)
# On Railway (api) and Vercel (web), set the same names in each service's settings.
# Never commit a real .env or .env.local.
#
# Every provider defaults to a fake, so a fresh checkout runs with no keys at all.
# The "production" column says what to set when going live (DECISIONS.md D10, D11, D12, D32).

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# local | test | ci | production
ENV=local

# Postgres with pgvector. Local: the apt-installed Postgres 16.
# Production: the Railway Postgres service over its private domain (docs/deploy.md), as
# postgresql+asyncpg://<user>:<password>@<private-domain>:5432/<db>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rizalai_test

# Sessions (D33). The API signs anonymous session tokens with this secret.
# Generate with: openssl rand -hex 32. AUTH_JWKS_URL is the hook for a future identity provider.
SESSION_JWT_SECRET=
AUTH_JWKS_URL=

# CORS (D36). Comma-separated web origins allowed to call the API from a browser; production
# lists the Vercel URL. Never leave it blank: empty means no origin is allowed. The optional
# regex admits Vercel preview hostnames. Anchor it on the team suffix Vercel appends to every
# preview hostname, for example https://rizal-ai-[a-z0-9-]+-<team>\.vercel\.app; a bare
# project prefix also matches anyone's Vercel project named rizal-ai-<anything>.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=

# Authored lessons, relative to apps/api.
CONTENT_DIR=../../content

# Logging level for the API's own loggers (DEBUG, INFO, WARNING). INFO shows
# reflection fallbacks and the like in Railway's logs.
LOG_LEVEL=INFO

# LLM for the "In Rizal's voice" reflection.
# LLM_PROVIDER: fake | openrouter | anthropic. Production: openrouter (D32).
# LLM_MODEL: empty means the provider default, anthropic/claude-opus-5 on openrouter,
#            claude-opus-5 on anthropic. Any OpenRouter model id works for the eval harness.
LLM_PROVIDER=fake
LLM_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings for source_passages.
# EMBEDDINGS_PROVIDER: fake | deepinfra. Production: deepinfra with BAAI/bge-m3 (D10).
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=BAAI/bge-m3

# Pre-rendered vignette audio (D12, D33).
# AUDIO_STORE: local | s3. The API serves either at /audio/{key}; production uses a
# Railway bucket, whose endpoint and keys Railway exposes on the bucket service.
# TTS_ENGINE: fake | mms | xtts | google. Pick after the bake-off (rizalai tts-bakeoff).
# XTTS_SPEAKER_WAV: path to a reference clip, only for the xtts engine.
AUDIO_STORE=local
AUDIO_LOCAL_DIR=data/audio
AUDIO_BASE_URL=http://localhost:8000/audio
S3_ENDPOINT_URL=
S3_BUCKET=audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
TTS_ENGINE=fake
XTTS_SPEAKER_WAV=

# Google Cloud Text-to-Speech reads application default credentials, not a variable
# of ours. Set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json to enable it.

# ---------------------------------------------------------------------------
# Web (apps/web), all public at build time
# ---------------------------------------------------------------------------

# mock: fixtures only, no backend or credentials (unit tests, Playwright, quick UI work).
# Empty: talk to the real API. Production: empty.
NEXT_PUBLIC_API_MODE=mock

# Where the FastAPI service lives. Production: the Railway service URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The browser gets its anonymous session from the API (POST /session/anonymous, D33)
# and never talks to the database, so no other public variables are needed.
