# Docker reads only the ignore file at the build context root, which is the
# repo root for apps/api/Dockerfile (DECISIONS.md D37).

# VCS and tooling
.git
.github
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/htmlcov
**/.coverage
**/coverage.xml

# Node and the web app (deployed by Vercel)
**/node_modules
**/.next
apps/web

# Secrets: env files never enter the image; the examples are harmless
**/.env
**/.env.*
!**/.env.example

# Not needed at runtime
apps/api/tests
apps/api/data/audio
apps/api/samples
evals
samples
docs
packages
